# --- Server và frontend ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- MongoDB và JWT ---
MONGODB_URI=mongodb://127.0.0.1:27017/smart_queue
JWT_SECRET=

# --- Đăng nhập Google dành cho sinh viên ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Gemini: hỏi đáp RAG và trích xuất bản nháp đặt lịch ---
GEMINI_API_KEY=
AI_CHAT_MODEL=gemini-3.5-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_TIMEOUT_MS=25000

# --- Chroma: kho vector phục vụ RAG ---
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=smartqueue_knowledge

# --- Chia đoạn và truy xuất tài liệu ---
RAG_CHUNK_OVERLAP_CHARS=200
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.6

# --- Thống kê chi phí AI ---
AI_BILLING_TIER=unconfigured

