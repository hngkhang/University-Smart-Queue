# Copy to backend/.env. Use the URI of the existing database containing your users.
# This local example requires a running MongoDB instance.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_queue
# Set a long, randomly generated secret before signing in.
JWT_SECRET=
PORT=5000
CLIENT_URL=http://localhost:5173

# AI usage: declare your actual Gemini billing tier: free or paid.
# Leave unconfigured if unknown. List-price cost estimates remain available.
AI_BILLING_TIER=unconfigured
